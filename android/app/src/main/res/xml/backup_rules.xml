<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the encrypted credential store out of cloud backups: its wrapping key
     lives in the Android Keystore and cannot be restored onto another device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
</full-backup-content>
